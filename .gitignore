# Blog 项目根目录 .gitignore
# 管理 frontend/ 和 backend/ 两个子项目，忽略无关目录和生成文件

# ========== 无关目录 ==========
Geeker-Admin/
koi-ui/
tt/

# ========== node_modules ==========
node_modules/
frontend/node_modules/
frontend/dist/

# ========== Java build ==========
backend/target/
backend/**/*.jar
backend/**/*.class

# ========== 敏感配置 ==========
backend/src/main/resources/application-local.yml
memory/local.properties
memory/keystore/

# ========== Android memory/ ==========
memory/.gradle/
memory/build/
memory/.cxx/
memory/.externalNativeBuild/
memory/app/build/
memory/*.apk
memory/*.aab
memory/*.jks
memory/*.png
memory/*.jpg
memory/memory-*.xml

# ========== OS ==========
.DS_Store
Thumbs.db
