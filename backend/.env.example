# backend/.env.example —— 复制为 backend/.env 后填写（.env 已被 .gitignore 排除）
#   cp backend/.env.example backend/.env
#
# application.yml 里已配置：
#   spring.config.import: optional:file:.env[.properties]
# 所以从 backend/ 目录启动时会被自动读取，不需要 export。

# ============================================================
# 一、实际生效：Supabase 托管 PostgreSQL 17
# ============================================================
# 两种连接方式，二选一（改 DB_URL 即可，用户名不同！）

# 方式 A（推荐）：Session pooler（Supavisor，端口 5432，用户名带项目 ref）
# 本项目实测落在 ap-northeast-2；可在 Dashboard → Connect 直接复制，不要手拼
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.tvohmylewzftfpczikpn

# 方式 B：直连（Dashboard 里的 direct connection 就是这条）
# 注意：db.<ref>.supabase.co **只有 AAAA 记录**，本机实测 `connection timeout expired`（无 IPv6 出口）。
# 只有两种情况下能用：① 机器有可用 IPv6；② 买了 Supabase 的 IPv4 add-on。
# 用户名是 postgres（不带 ref），端口 5432。
# DB_URL=jdbc:postgresql://db.tvohmylewzftfpczikpn.supabase.co:5432/postgres?sslmode=require
# DB_USER=postgres

# 数据库密码（Dashboard → Project Settings → Database → Database password）
# 注意：不是 sb_secret_xxx，那是 API Key，连不了库
DB_PASSWORD=

# 迁移开关。生产保持 true，让 Flyway 在启动时推进 V1/V2…；临时排障可设 false
FLYWAY_ENABLED=true

# ============================================================
# 二、占位：当前代码未使用，接 Auth / Storage 时才需要
# ============================================================
# 现状：本项目只把 Supabase 当托管 PG 用，鉴权仍是自签 JWT（JJWT + BCrypt），
# 因此下面四个值现在没有任何代码读取，留着是为了后续切换时不用再翻文档。
SUPABASE_URL=https://tvohmylewzftfpczikpn.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_cl_rJPf6mpBfHoStl1hqbQ_CQ-WQUOi
SUPABASE_JWKS_URL=https://tvohmylewzftfpczikpn.supabase.co/auth/v1/.well-known/jwks.json
# secret key 永不入库、永不写进示例文件。真要用时在后台单独取，只放本地 .env。
SUPABASE_SECRET_KEY=
