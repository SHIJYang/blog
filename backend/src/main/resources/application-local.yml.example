# 本地配置模板 —— 复制为 application-local.yml 后填入真实值
# application-local.yml 已被 .gitignore 排除，不会进仓库
#   cp application-local.yml.example application-local.yml
#
# 本文件只放"本地开发与生产不同"的部分。数据库驱动、Flyway、连接池默认值
# 都在 application.yml 里，这里不重复。

spring:
  datasource:
    # 本地 docker compose 的 PostgreSQL 16 + pgvector
    url: jdbc:postgresql://localhost:5432/blog
    username: blog
    password: blog

jwt:
  # 必须替换：随便一串 64 位以上随机字符
  secret: CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_64_CHARS________________

# 仅在调试 SQL 时打开，生产务必注释
mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

# 记忆照片：本地受控目录（新写入的私密照片不允许走公网图床）
memory:
  upload-dir: uploads/memory
  access-prefix: /uploads/memory

# ============================================================
# 远程 / 生产：不写本文件，改用环境变量（backend/.env 或容器 env）
# ------------------------------------------------------------
# Supabase 托管 PG 的连接串（已实测确认本项目在 ap-northeast-2 区域）：
#   DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USER=postgres.tvohmylewzftfpczikpn
#   DB_PASSWORD=<Supabase 后台的 Database Password>
#
# 三个坑：
#   1. 必须走 pooler（5432 会话模式）。直连 db.<ref>.supabase.co 只有 AAAA 记录，
#      IPv4-only 网络（包括不少家用宽带与云主机）必然连接超时。
#   2. 不要用 6543 事务模式：Flyway 迁移依赖会话级 advisory lock，事务模式会失败。
#   3. 这里要的是"数据库密码"，不是 sb_secret_xxx —— 那是 API Key，连不了库。
